# Algebra · environment variables. Copy to .env for local scripts; for the Worker use `wrangler secret put NAME`.
# NEVER commit real values. Public settings live in worker/wrangler.toml [vars] and site/config.mjs.

# --- Site build (scripts/build.mjs) -------------------------------------------------------------
SITE_ORIGIN=https://algebra.algbr.eu      # canonical origin (canonical, hreflang, sitemap, Stripe return URLs); https://algbr.eu after the switch (ALGBR_TARGET.md)
SITE_MODE=preview                         # preview = noindex + banner + test payments only · live = launch
API_BASE=/api                             # where the browser calls the Worker (same host via route) or https://algebra-api.<account>.workers.dev/api
VAT_MODE=kleinunternehmer                 # kleinunternehmer (§ 19 UStG, no VAT shown) or regular (incl. VAT) · LEGAL REVIEW

# --- Payments (Stripe) · secrets ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx             # NEEDS CREDENTIALS · test key until launch (the Worker refuses live keys in preview)
STRIPE_WEBHOOK_SECRET=whsec_xxx           # NEEDS CREDENTIALS · endpoint: https://<site>/api/stripe/webhook
                                          # events: checkout.session.completed, checkout.session.async_payment_succeeded,
                                          # checkout.session.async_payment_failed, checkout.session.expired, charge.refunded
# PayPal, Klarna, SEPA, giropay etc. are switched on in the Stripe dashboard (dynamic payment methods), no extra key.

# --- Fulfillment (Valadio REST API) · secrets -------------------------------------------------------
FULFILLMENT_PROVIDER=valadio              # valadio | mock (local tests). Mapping: worker/src/fulfillment/mapping.js (server only)
VALADIO_API_BASE_URL=                     # NEEDS CREDENTIALS · from the official API docs
VALADIO_API_KEY=                          # NEEDS CREDENTIALS
VALADIO_API_SECRET=                       # NEEDS CREDENTIALS (if their auth uses one)
VALADIO_WEBHOOK_SECRET=                   # NEEDS CREDENTIALS · webhook endpoint: https://<site>/api/webhooks/valadio
VALADIO_SANDBOX=true                      # true = no real production order is ever sent

# --- E-mail (Resend) · secrets ---------------------------------------------------------------------
RESEND_API_KEY=                           # NEEDS CREDENTIALS · without it, e-mails are logged only (MOCKED)
MAIL_FROM="Algebra <service@algbr.eu>"    # same as worker/wrangler.toml; sending domain verified in Resend
OWNER_EMAIL=                              # NEEDS USER INPUT · receives contact messages and order alerts

# --- Database (Cloudflare D1) ----------------------------------------------------------------------
# binding DB in worker/wrangler.toml; database_id from `npx wrangler d1 create algebra`

# --- Admin -----------------------------------------------------------------------------------------
ADMIN_TOKEN=                              # long random string for /api/admin/* (Authorization: Bearer …)

# --- Analytics (only after consent) ----------------------------------------------------------------
ANALYTICS_PROVIDER=                       # NEEDS USER INPUT · e.g. plausible | ga4 (see docs/ANALYTICS.md)
ANALYTICS_ID=

# --- CMS / e-commerce provider ---------------------------------------------------------------------
# None: the catalogue is data/catalog.mjs in Git (no monthly fee). See README "Why no Shopify".

# --- Local scripts ---------------------------------------------------------------------------------
PLAYWRIGHT_MODULE=                        # path to playwright/index.mjs for mockup/print PNG export and QA screenshots
