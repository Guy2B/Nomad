{
  "name": "algebra-shop",
  "version": "1.0.0",
  "description": "Algebra: European contemporary essentials. Static shop + Cloudflare Worker (Stripe, D1, POD supplier adapter).",
  "scripts": {
    "brand": "node scripts/brand.mjs",
    "capsule": "node scripts/physics.mjs",
    "mockups": "node scripts/mockups.mjs",
    "economics": "node scripts/economics.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node --no-warnings scripts/dev.mjs",
    "test": "node --no-warnings --test tests/*.test.mjs",
    "qa": "node scripts/qa.mjs",
    "worker:check": "cd worker && wrangler deploy --dry-run --outdir ../.wrangler-dry",
    "worker:deploy": "cd worker && wrangler deploy",
    "pages:deploy": "wrangler pages deploy dist --project-name algebra-shop"
  },
  "author": "Al.G.B.r",
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/caveat": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "opentype.js": "^1.3.4"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
