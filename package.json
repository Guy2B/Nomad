{
  "name": "nomad-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ALGBr — multi-store dropshipping platform: storefront, Stripe checkout & invoices, CRM, automatic supplier orders (CJdropshipping). by Al.G.B.r.",
  "scripts": {
    "build:go": "node scripts/build.mjs nomad",
    "build:space": "node scripts/build.mjs appart-reset",
    "build:ease": "node scripts/build.mjs body-care",
    "images": "node scripts/optimize-images.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:api": "node scripts/build.mjs backend && esbuild cloudflare/worker.mjs --bundle --format=esm --platform=neutral --main-fields=module,main --external:node:* --outfile=dist/_worker.js",
    "deploy:api": "npm run build:api && cd cloudflare && wrangler pages deploy --branch main"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sharp": "^0.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}
